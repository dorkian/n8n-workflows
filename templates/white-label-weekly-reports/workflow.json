              "value": "=<!DOCTYPE html><html><head><meta charset=\"utf-8\"><style>body{font-family:Arial,Helvetica,sans-serif;color:#222;max-width:760px;margin:32px auto;padding:0 24px}h1{font-size:24px;border-bottom:2px solid #111;padding-bottom:8px}.logo{max-height:64px;margin-bottom:16px}.kpi-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;margin:24px 0}.kpi{border:1px solid #e5e5e5;border-radius:8px;padding:12px}.kpi .label{font-size:11px;color:#666;text-transform:uppercase}.kpi .value{font-size:22px;font-weight:600;margin-top:4px}.section{margin-top:24px}.narrative{background:#fafafa;border-left:3px solid #111;padding:16px;font-size:14px;line-height:1.6}table{width:100%;border-collapse:collapse;font-size:13px}th,td{padding:8px;border-bottom:1px solid #eee;text-align:left}th{background:#f5f5f5}</style></head><body>{{ $('Combine Metrics').item.json.client_logo_url ? '<img class=\"logo\" src=\"' + $('Combine Metrics').item.json.client_logo_url + '\" />' : '' }}<h1>{{ $('Combine Metrics').item.json.client_name }} - Weekly Performance Report</h1><p style=\"color:#666;font-size:13px\">{{ $('Combine Metrics').item.json.period_label }}</p><div class=\"kpi-grid\"><div class=\"kpi\"><div class=\"label\">New Leads</div><div class=\"value\">{{ $('Combine Metrics').item.json.hs_new_leads }}</div></div><div class=\"kpi\"><div class=\"label\">New Deals</div><div class=\"value\">{{ $('Combine Metrics').item.json.hs_new_deals }}</div></div><div class=\"kpi\"><div class=\"label\">Pipeline Value</div><div class=\"value\">EUR {{ Number($('Combine Metrics').item.json.hs_pipeline_value).toFixed(0) }}</div></div><div class=\"kpi\"><div class=\"label\">Total Ad Spend</div><div class=\"value\">EUR {{ Number($('Combine Metrics').item.json.total_ad_spend).toFixed(0) }}</div></div><div class=\"kpi\"><div class=\"label\">Total Clicks</div><div class=\"value\">{{ $('Combine Metrics').item.json.total_clicks }}</div></div><div class=\"kpi\"><div class=\"label\">Impressions</div><div class=\"value\">{{ $('Combine Metrics').item.json.total_impressions }}</div></div></div><div class=\"section\"><h3>Performance Commentary</h3><div class=\"narrative\">{{ $json.narrative }}</div></div><div class=\"section\"><h3>Channel Breakdown</h3><table><tr><th>Channel</th><th>Spend</th><th>Leads / Conv.</th><th>CPL / CPC</th></tr><tr><td>Meta Ads</td><td>EUR {{ Number($('Combine Metrics').item.json.meta_spend).toFixed(2) }}</td><td>{{ $('Combine Metrics').item.json.meta_leads }}</td><td>EUR {{ Number($('Combine Metrics').item.json.meta_cpl).toFixed(2) }}</td></tr><tr><td>Google Ads</td><td>EUR {{ Number($('Combine Metrics').item.json.gads_spend).toFixed(2) }}</td><td>{{ $('Combine Metrics').item.json.gads_conversions }}</td><td>EUR {{ Number($('Combine Metrics').item.json.gads_cpc).toFixed(2) }}</td></tr></table></div></body></html>",
