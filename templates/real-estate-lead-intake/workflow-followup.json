            {
              "id": "up003",
              "name": "next_followup_date",
              "value": "={{ (Number($('Build Follow-up Prompt').item.json.followup_count) + 1) >= 3 ? '' : DateTime.now().plus({days: 2}).toFormat('yyyy-MM-dd') }}",
              "type": "string"
            },
            {
              "id": "up004",
              "name": "status",
              "value": "={{ (Number($('Build Follow-up Prompt').item.json.followup_count) + 1) >= 3 ? 'closed' : 'active' }}",
              "type": "string"
            },
            {
              "id": "up005",
              "name": "last_updated",
              "value": "={{ DateTime.now().toISO() }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      }
    },
    {
      "id": "gs-update-013",
      "name": "Update Lead Row",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        2180,
        300
      ],
      "onError": "continueErrorOutput",
      "parameters": {
