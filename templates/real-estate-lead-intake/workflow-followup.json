        "subject": "={{ $json.digest_subject }}",
        "emailType": "html",
        "message": "={{ $json.digest_body }}"
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "GMAILOAUTH2_CREDENTIAL_ID",
          "name": "Gmail account"
        }
      }
    },
