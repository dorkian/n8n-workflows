      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "GOOGLESHEETSOAUTH2API_CREDENTIAL_ID",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "id": "code-digest-014",
      "name": "Prepare Digest Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2400,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all();\nconst today = DateTime.now().toFormat('yyyy-MM-dd');\nconst count = items.length;\nreturn [{\n  json: {\n    today: today,\n    followed_up_count: count,\n    digest_subject: 'Daily Lead Digest - ' + today,\n    digest_body: '<h2>Daily Lead Digest &mdash; ' + today + '</h2>' +\n      '<p><strong>Follow-up emails sent today:</strong> ' + count + '</p>' +\n      '<p>Check your Master Lead Log Google Sheet for full details on all active leads.</p>' +\n      '<p><em>Powered by Real Estate Lead Recovery &mdash; n8n Template</em></p>'\n  }\n}];"
      }
    },
