            "followup_count": "={{ $json.followup_count }}",
            "next_followup_date": "={{ $json.next_followup_date }}",
            "status": "={{ $json.status }}",
            "last_updated": "={{ $json.last_updated }}"
          },
          "matchingColumns": [
            "lead_id"
          ],
          "schema": [
